{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/server.js" }
  ],
  "crons": [
    { "path": "/api/cron/earnings",  "schedule": "0 5 * * 1-5" },
    { "path": "/api/cron/briefings", "schedule": "30 5 * * 1-5" },
    { "path": "/api/cron/warmup",    "schedule": "0 6 * * *" }
  ]
}
